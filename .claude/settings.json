{
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run dev *)",
      "Bash(node --test *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run dev *)",
      "PowerShell(node --test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  }
}
