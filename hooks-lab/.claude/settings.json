{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-jsdoc.js\"",
            "timeout": 15,
            "statusMessage": "Checking JSDoc..."
          }
        ]
      }
    ]
  }
}
